# Environment variables example
# Copy this file to `.env` or set these values in your Vercel/Cloudflare environment variables.

# Cloudflare D1 REST endpoint (DO NOT include secrets here — this URL is a non-secret identifier)
D1_REST_URL=https://api.cloudflare.com/client/v4/accounts/5b1bd000cd4af0cedf95a25940a8d53f/d1/database/50cf4075-3383-4700-9dae-736c308e419f/queries

# Cloudflare API token with permission to run D1 queries (keep secret)
D1_AUTH=<YOUR_CLOUDFLARE_API_TOKEN>

# Symmetric HS256 secret for signing JWTs (keep secret)
JWT_SECRET=<YOUR_JWT_SECRET>
